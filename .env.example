# Runtime paths
DATA_DIR=/data
PORT=8787
AUTH_DIR=/data/auth

# Optional. Full history sync can be noisy; normal backfill uses lightweight anchors.
WHATSAPP_SYNC_FULL_HISTORY=false

# Message retention. Unsummarized messages wait up to MESSAGE_RETENTION_HOURS for a digest;
# summarized ones are deleted after SUMMARIZED_MESSAGE_RETENTION_HOURS.
MESSAGE_RETENTION_HOURS=168
SUMMARIZED_MESSAGE_RETENTION_HOURS=24

# Logging
APP_LOG_LEVEL=info
LOG_LEVEL=silent

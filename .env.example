# LLM provider (OpenAI-compatible)
LLM_API_KEY=sk-...

# Telegram bot
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID_1=-100111222333
TELEGRAM_CHAT_ID_2=                 # leave empty if only one recipient

# WhatsApp groups to summarise (required — keep out of git, set here in .env)
MUSUP_CHAT_JIDS=jid1@g.us,jid2@g.us
MUSUP_CHAT_LABELS_CSV=jid1@g.us=Group One,jid2@g.us=Group Two

# Optional overrides
# MUSUP_DIGEST_CRON=0 0 6,19 * * ?
# MUSUP_DIGEST_WINDOW_HOURS=13
# MUSUP_LLM_MODEL=gpt-4o-mini
# MUSUP_LLM_API_URL=https://api.openai.com/v1/chat/completions

# ── Google Classroom ────────────────────────────────────────────────────────
# Setup: run `npx tsx collector/src/auth-classroom.ts` once locally to obtain
# the token, then copy both files to data/auth/ on the NAS.
#
# CLASSROOM_CREDENTIALS_PATH=/data/auth/classroom-credentials.json
# CLASSROOM_TOKEN_PATH=/data/auth/classroom-token.json
# CLASSROOM_POLL_INTERVAL_MINUTES=30
#
# After enabling Classroom, add each course JID (classroom:<courseId>) to
# MUSUP_CHAT_JIDS and MUSUP_CHAT_LABELS_CSV so the processor includes them
# in digests. Course IDs appear in data/chats.json after the first poll.

# ── iPasen ──────────────────────────────────────────────────────────────────
# Complete the mitmproxy session first (see collector/src/sources/ipasen.ts),
# then implement the client and set credentials here.
#
# IPASEN_USERNAME=
# IPASEN_PASSWORD=
# IPASEN_POLL_INTERVAL_MINUTES=60
